# Copie para .env e preencha. Nunca versione o .env.

# Front-end (expostas ao navegador — use apenas chaves públicas/anon)
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=

# Servidor SSR (podem apontar para o endereço interno da rede Docker)
SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLISHABLE_KEY=
# Só para rotinas administrativas no servidor. Nunca use no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# API própria (pasta api/). Local: http://localhost:4000
VITE_API_URL=http://localhost:4000
# false = só convite (esconde "Criar conta")
VITE_SIGNUP_ENABLED=true
