# Copie para infra/.env. Gere os segredos com:  node ../scripts/generate-keys.mjs
# NUNCA versione o infra/.env.

############ Segredos ############
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
JWT_EXP=3600

############ Endereços ############
# Local: SITE_URL=http://localhost:3000  e  API_EXTERNAL_URL=http://localhost:8000
# VPS:   SITE_URL=https://app.seudominio.com.br  e  API_EXTERNAL_URL=https://api.seudominio.com.br
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000

# Só para o perfil prod (Caddy + HTTPS automático)
APP_DOMAIN=app.seudominio.com.br
API_DOMAIN=api.seudominio.com.br
ACME_EMAIL=

############ Portas locais ############
WEB_PORT=3000
KONG_PORT=8000
DB_PORT=54322
STUDIO_PORT=3001

############ Autenticação ############
DISABLE_SIGNUP=false
# true só em desenvolvimento (dispensa confirmação por e-mail)
MAILER_AUTOCONFIRM=true
PASSWORD_MIN_LENGTH=8

############ E-mail (recuperação de senha e convites) ############
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=JMG Reformas
